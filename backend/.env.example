# Smart Study Planner — backend environment
# Copy to .env and replace the placeholder values. Never commit the real .env.

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-a-different-long-random-string

# Database (defaults to sqlite at backend/instance/app.db when unset)
DATABASE_URL=sqlite:///app.db

# Token lifetimes (seconds)
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# CORS — comma separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Uploads
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=20

# AI provider — keys are read server-side only and never returned to clients.
# Leave every key blank to run without AI generation: the assistant then
# answers from your indexed study material and reports ai_configured=false.
# AI_PROVIDER is inferred from whichever key is set; set it explicitly to
# openai, gemini or offline to override.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# AI guardrails
AI_RATE_LIMIT=20 per hour
AI_TIMEOUT_SECONDS=30
AI_MAX_MESSAGE_CHARS=4000
AI_MAX_HISTORY_MESSAGES=10
AI_RETRIEVAL_TOP_K=4
AI_MAX_OUTPUT_TOKENS=900

# Development convenience: return email verification / password reset tokens in
# API responses because no SMTP provider is configured. Keep false in production.
EXPOSE_DEV_TOKENS=true
